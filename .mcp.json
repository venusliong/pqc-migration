{
  "mcpServers": {
    "ql-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "codeql-development-mcp-server"
      ],
      "env": {
        "CODEQL_PATH": "${HOME}/tools/codeql/codeql",
        "CODEQL_DATABASES_BASE_DIRS": "${CODEQL_DATABASES_BASE_DIRS:-dbs}"
      }
    }
  }
}
